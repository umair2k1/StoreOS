# Auto-detect text files and normalize to LF in repository
* text=auto eol=lf

# Explicit text files
*.cs text eol=lf
*.ts text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sql text eol=lf
*.props text eol=lf
*.csproj text eol=lf
*.sln text eol=lf
*.html text eol=lf
*.scss text eol=lf
*.css text eol=lf
*.dockerfile text eol=lf
Dockerfile* text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.db binary
